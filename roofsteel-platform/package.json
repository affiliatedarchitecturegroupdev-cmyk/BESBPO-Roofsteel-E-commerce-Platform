{
  "name": "roofsteel-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Roofsteel e-commerce platform monorepo. See Roofsteel-Ecommerce-Platform-Specification.docx for the full spec.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:web": "npm --workspace apps/web run dev",
    "loc:check": "bash scripts/check-loc.sh",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^5.19.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/besbpo-group/roofsteel-platform.git"
  },
  "license": "UNLICENSED"
}