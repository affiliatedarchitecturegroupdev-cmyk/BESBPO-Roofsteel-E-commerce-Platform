# ---- Database & Cache (Render-native managed services — spec Section 2.1) ----
DATABASE_URL="postgresql://user:password@localhost:5432/roofsteel"
REDIS_URL="redis://localhost:6379"

# ---- Auth ----
SESSION_SECRET="replace-me"
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ---- Payments (spec Section 5) ----
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_SANDBOX="true"       # set to "false" for production
PAYFAST_RETURN_URL=""        # https://yourdomain.com/checkout/success
PAYFAST_CANCEL_URL=""        # https://yourdomain.com/checkout/cancelled
PAYFAST_NOTIFY_URL=""        # https://yourdomain.com/v1/orders/webhooks/payfast
LULAPAY_API_KEY=""           # requires Lulapay Partner onboarding — spec Section 8, open question
LULAPAY_API_URL=""           # https://api.lulapay.co.za (Partner API base URL)
LULAPAY_WEBHOOK_SECRET=""
PAYJUSTNOW_MERCHANT_ID=""    # Retail tier only — spec Section 5
PAYJUSTNOW_API_KEY=""
PAYJUSTNOW_API_URL=""        # https://api.payjustnow.com

# ---- App ----
PORT=4000
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/v1"
